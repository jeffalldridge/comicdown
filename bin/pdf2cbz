#!/bin/bash
# pdf2cbz — losslessly convert comic-book PDFs to CBZ.
# Part of comicdown: https://github.com/jeffalldridge/comicdown
#
# Targets macOS system bash 3.2: no associative arrays; never expand an
# array that may be empty while set -u is active.

VERSION="0.1.0"
RENDER_DPI=300
RENDER_QUALITY=90
NOTIFY=0

die() { printf 'pdf2cbz: %s\n' "$1" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage: pdf2cbz [--notify] file.pdf [more.pdf ...]

Losslessly extracts the embedded page images from comic-book PDFs and packs
them into a .cbz next to each source file. Pages that cannot be extracted
losslessly are rendered at their inherent page density (72-600 DPI) and
reported.

Options:
  --notify     Also report via macOS notification (used by the Quick Action)
  --version    Print version
  -h, --help   Show this help
EOF
}

notify() {
  osascript -e "display notification \"${1//\"/\\\"}\" with title \"comicdown\"" \
    >/dev/null 2>&1 || true
}

check_deps() {
  local cmd missing=""
  for cmd in pdfinfo pdfimages pdftoppm; do
    command -v "$cmd" >/dev/null || missing="$missing $cmd"
  done
  if [ -n "$missing" ]; then
    local msg="missing$missing — install with: brew install poppler"
    if [ "$NOTIFY" = 1 ]; then notify "$msg"; fi
    die "$msg"
  fi
}

# classify_pages: stdin = `pdfimages -list` output, $1 = page count.
# Prints one line per page: "<page> <status> <reason> <dpi>". status is
# lossless or fallback; dpi is the page's suggested render density (max
# x-ppi/y-ppi over its raster images, clamped 72-600) or "-" if the page has
# no raster images. Lossless requires exactly one real raster image, encoded
# as jpeg (DCT) or image (flate), in a non-CMYK colorspace, with no
# masks/stencils on the page.
classify_pages() {
  awk -v pages="$1" '
    NR <= 2 { next }          # header + separator
    NF < 9 { next }
    {
      page = $1; type = $3; color = $6; comp = $7; enc = $9
      if (type == "image") {
        count[page]++
        if (count[page] > 1 && !(page in reason)) reason[page] = "multi-image"
        if (enc != "jpeg" && enc != "image" && !(page in reason)) reason[page] = "enc:" enc
        if ((color == "cmyk" || comp == 4) && !(page in reason)) reason[page] = "cmyk"
        xp = $13 + 0; yp = $14 + 0
        m = (xp > yp) ? xp : yp
        if (m > 0 && m > ppi[page]) ppi[page] = m
      } else if (!(page in reason)) {
        reason[page] = "mask"   # smask/stencil rows need compositing
      }
    }
    END {
      for (p = 1; p <= pages; p++) {
        if (ppi[p] > 0) {
          d = ppi[p]
          if (d < 72) d = 72
          if (d > 600) d = 600
        } else {
          d = "-"
        }
        if (p in reason)          print p, "fallback", reason[p], d
        else if (count[p] == 1)   print p, "lossless", "-", d
        else if (count[p] == "")  print p, "fallback", "no-image", d
        else                      print p, "fallback", "multi-image", d
      }
    }'
}

page_count() { pdfinfo "$1" 2>/dev/null | awk '/^Pages:/ {print $2}'; }

# find_page_image tmpdir page -> path of the single extracted image for page.
# Filenames look like img-PPP-NNN.ext (padding unknown); parse, don't assume.
find_page_image() {
  local dir="$1" page="$2" f base p
  for f in "$dir"/img-*; do
    [ -e "$f" ] || continue
    base="${f##*/}"
    p="${base#img-}"
    p="${p%%-*}"
    case "$p" in ''|*[!0-9]*) continue ;; esac
    if [ "$((10#$p))" -eq "$page" ]; then
      printf '%s\n' "$f"
      return 0
    fi
  done
  return 1
}

# out_path pdf -> collision-free sibling .cbz path
out_path() {
  local base="${1%.[Pp][Dd][Ff]}"
  local out="$base.cbz" n=1
  while [ -e "$out" ]; do
    out="$base ($n).cbz"
    n=$((n + 1))
  done
  printf '%s\n' "$out"
}

# convert_pdf pdf -> prints one summary line on success
convert_pdf() {
  local pdf="$1"
  [ -f "$pdf" ] || { printf '%s: no such file\n' "$pdf" >&2; return 1; }
  local pages
  pages=$(page_count "$pdf")
  case "$pages" in
    ''|*[!0-9]*) printf '%s: could not read page count (not a PDF?)\n' "$pdf" >&2; return 1 ;;
  esac

  local tmp stage
  tmp=$(mktemp -d "$TMP_ROOT/pdf.XXXXXX") || {
    printf '%s: cannot create temp dir\n' "$pdf" >&2; return 1; }
  stage="$tmp/stage"
  mkdir "$stage" || { printf '%s: cannot create staging dir\n' "$pdf" >&2; return 1; }

  local plan
  plan=$(pdfimages -list "$pdf" 2>/dev/null | classify_pages "$pages")
  pdfimages -p -all "$pdf" "$tmp/img" 2>/dev/null || true

  local width=${#pages}
  if [ "$width" -lt 3 ]; then width=3; fi
  # NOTE: never use `[ cond ] && cmd` for optional steps in this script —
  # under set -e a false condition aborts the whole run. Always if/then.
  #
  # NOTE: convert_pdf is invoked as `if summary=$(convert_pdf ...); then` in
  # main. Because the whole call sits in a tested command substitution, bash
  # suppresses errexit for every command inside this function body, not just
  # the top-level call — a well-known bash gotcha. So nothing in here can
  # rely on `set -e` to stop a failed step; every side-effecting command
  # (mkdir, cp, sips, zip, mv, ...) must be explicitly checked.

  local page status reason dpi rdpi src ext dest copy_failed
  local fallback_list="" fallback_count=0
  : > "$tmp/reasons.txt"
  while read -r page status reason dpi; do
    copy_failed=0
    src=""
    if [ "$status" = "lossless" ]; then
      src=$(find_page_image "$tmp" "$page") || reason="missing-extraction"
    fi
    if [ -z "$src" ]; then
      rdpi="$RENDER_DPI"
      if [ "$dpi" != "-" ]; then rdpi="$dpi"; fi
      render_page "$pdf" "$page" "$tmp" "$rdpi" || {
        printf '%s: page %s failed to render\n' "$pdf" "$page" >&2
        if [ -s "$tmp/render-$page.err" ]; then cat "$tmp/render-$page.err" >&2; fi
        return 1; }
      src=$(find "$tmp/render-$page" -type f -size +0 | head -n 1)
      fallback_list="${fallback_list:+$fallback_list, }$page ($rdpi DPI)"
      fallback_count=$((fallback_count + 1))
      printf 'page %s: %s — rendered at %s DPI\n' "$page" "$reason" "$rdpi" >> "$tmp/reasons.txt"
    fi
    ext="${src##*.}"
    dest=$(printf '%s/%0*d' "$stage" "$width" "$page")
    case "$ext" in
      # tif/tiff shouldn't reach here today — classify_pages already routes
      # CMYK/TIFF-producing pages to fallback, so this is belt-and-suspenders.
      tif|tiff) sips -s format png "$src" --out "$dest.png" >/dev/null 2>&1 || copy_failed=1 ;;
      jpeg)     cp "$src" "$dest.jpg" || copy_failed=1 ;;
      *)        cp "$src" "$dest.$ext" || copy_failed=1 ;;
    esac
    if [ "${copy_failed:-0}" = 1 ]; then
      printf '%s: page %s failed to stage\n' "$pdf" "$page" >&2
      return 1
    fi
  done <<EOF
$plan
EOF

  local out name
  out=$(out_path "$pdf")
  (cd "$stage" && zip -q -0 -X "$tmp/out.zip" -- *) || {
    printf '%s: zip failed\n' "$pdf" >&2; return 1; }
  mv "$tmp/out.zip" "$out" || {
    printf '%s: cannot write %s\n' "$pdf" "$out" >&2; return 1; }
  name=$(basename "$out")

  local ok=$((pages - fallback_count)) summary
  if [ "$fallback_count" -eq 0 ]; then
    summary="$name: $pages/$pages pages lossless"
  else
    summary="$name: $ok/$pages pages lossless; rendered: $fallback_list"
    { printf '%s\n\n' "$summary"; cat "$tmp/reasons.txt"; } > "$out.log"
  fi
  printf '%s\n' "$summary"
}

# render_page pdf page tmp [dpi]: render one page to $tmp/render-$page/ as
# JPEG at the given DPI (defaults to RENDER_DPI when omitted).
render_page() {
  local pdf="$1" page="$2" tmp="$3" dpi="${4:-$RENDER_DPI}"
  mkdir -p "$tmp/render-$page" || return 1
  pdftoppm -jpeg -jpegopt "quality=$RENDER_QUALITY" -r "$dpi" \
    -f "$page" -l "$page" "$pdf" "$tmp/render-$page/page" 2>"$tmp/render-$page.err"
  [ -n "$(find "$tmp/render-$page" -type f -size +0 | head -n 1)" ]
}

main() {
  local files_count=0
  FILES=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --notify) NOTIFY=1 ;;
      --version) printf 'pdf2cbz %s\n' "$VERSION"; exit 0 ;;
      -h|--help) usage; exit 0 ;;
      -*) die "unknown option: $1 (see --help)" ;;
      *) FILES[files_count]="$1"; files_count=$((files_count + 1)) ;;
    esac
    shift
  done
  [ "$files_count" -gt 0 ] || { usage >&2; exit 1; }
  check_deps

  TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/comicdown.XXXXXX")
  trap 'rm -rf "$TMP_ROOT"' EXIT

  local i=0 failures=0 summary summaries=""
  while [ "$i" -lt "$files_count" ]; do
    if summary=$(convert_pdf "${FILES[$i]}"); then
      printf '%s\n' "$summary"
      summaries="${summaries:+$summaries
}$summary"
    else
      failures=$((failures + 1))
      summaries="${summaries:+$summaries
}$(basename "${FILES[$i]}"): FAILED"
    fi
    i=$((i + 1))
  done
  if [ "$NOTIFY" = 1 ]; then notify "$summaries"; fi
  [ "$failures" -eq 0 ]
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  set -euo pipefail
  main "$@"
fi
